<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="IHSMS-Architecture-MVT" version="22.1.0" type="device">
  <diagram id="mvt_architecture" name="MVT System Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Header -->
        <mxCell id="arch_title" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;IHSMS Model-View-Template (MVT) Architecture&lt;/b&gt;&lt;br&gt;Integrated Housing Services and Monitoring System · Talisay City Housing Authority (THA)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="800" height="50" as="geometry"/>
        </mxCell>

        <!-- Column 1: Client & Presentation -->
        <mxCell id="col1" value="&lt;b&gt;CLIENT &amp;amp; PRESENTATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Staff Portals (2nd, 4th Member, Inspector)&lt;br&gt;• Compiled Tailwind CSS 4 CLI Design System&lt;br&gt;• Dynamic Web TWAIN Local Scanner Bridge&lt;br&gt;• Vanilla JS + Fetch API Async Components&lt;br&gt;• SVG Relocation Site Plan Polygon Map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;align=left;spacing=12;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="210" height="340" as="geometry"/>
        </mxCell>

        <!-- Column 2: Web Server & Gateway -->
        <mxCell id="col2" value="&lt;b&gt;GATEWAY &amp;amp; ROUTING&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Railway Cloud Infrastructure&lt;br&gt;• Gunicorn WSGI Web Server&lt;br&gt;• WhiteNoise Static Asset Serving&lt;br&gt;• Security &amp;amp; CsrfViewMiddleware&lt;br&gt;• Custom Staff Portal Role Middleware&lt;br&gt;• Django Allauth Account Middleware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;align=left;spacing=12;fontSize=11;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="290" y="100" width="210" height="340" as="geometry"/>
        </mxCell>

        <!-- Connector Col1 -> Col2 -->
        <mxCell id="mvt_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="col1" target="col2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Column 3: Views & Controllers -->
        <mxCell id="col3" value="&lt;b&gt;DJANGO CONTROLLER (VIEWS)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• `intake`: Walk-in registration &amp;amp; intake forms&lt;br&gt;• `applications`: Scoring &amp;amp; eligibility review&lt;br&gt;• `application_form_pdf.py`: PyMuPDF engine&lt;br&gt;• `units`: Lot awarding &amp;amp; occupancy monitoring&lt;br&gt;• `cases`: Community dispute management&lt;br&gt;• Twilio SMS Dispatch &amp;amp; Activity Logger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#06B6D4;align=left;spacing=12;fontSize=11;fontColor=#0E7490;" vertex="1" parent="1">
          <mxGeometry x="540" y="100" width="220" height="340" as="geometry"/>
        </mxCell>

        <!-- Connector Col2 -> Col3 -->
        <mxCell id="mvt_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="col2" target="col3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Column 4: Models & Persistence -->
        <mxCell id="col4" value="&lt;b&gt;DATA MODELS &amp;amp; DATABASE&lt;/b&gt;&lt;br&gt;&lt;br&gt;• PostgreSQL 16 (psycopg3 driver)&lt;br&gt;• `Applicant` &amp;amp; `HouseholdMember`&lt;br&gt;• `Application` &amp;amp; `QueueEntry`&lt;br&gt;• `HousingUnit` &amp;amp; `LotAward`&lt;br&gt;• `Document` Vault &amp;amp; Blob Storage&lt;br&gt;• Immutable `Case` &amp;amp; `StaffActivity` Audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;align=left;spacing=12;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="800" y="100" width="210" height="340" as="geometry"/>
        </mxCell>

        <!-- Connector Col3 -> Col4 -->
        <mxCell id="mvt_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="col3" target="col4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
