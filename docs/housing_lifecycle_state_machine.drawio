<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="IHSMS-Architecture-StateMachine" version="22.1.0" type="device">
  <diagram id="housing_lifecycle" name="Socialized Housing Lifecycle State Machine">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Header -->
        <mxCell id="sm_title" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;Socialized Housing Lifecycle State Machine&lt;/b&gt;&lt;br&gt;Deterministic qualification gates, queue transitions, and post-occupancy monitoring flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="800" height="50" as="geometry"/>
        </mxCell>

        <!-- Phase 1: Intake -->
        <mxCell id="p1" value="&lt;b&gt;PHASE 1: Walk-in Intake&lt;/b&gt;&lt;br&gt;&lt;i&gt;status: registered&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Personal &amp;amp; family roster entered&lt;br&gt;• Generate APP-YYYYMMDD-XXXX&lt;br&gt;• Categorize displacement cause&lt;br&gt;• Enters document queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;align=left;spacing=10;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="220" height="150" as="geometry"/>
        </mxCell>

        <!-- Phase 2: Document Vault -->
        <mxCell id="p2" value="&lt;b&gt;PHASE 2: Document Collection&lt;/b&gt;&lt;br&gt;&lt;i&gt;documents_pending → complete&lt;/i&gt;&lt;br&gt;&lt;br&gt;• 7 mandatory documents verified&lt;br&gt;• Local DWT scanner ingestion&lt;br&gt;• Real-time checklist verification&lt;br&gt;• Handoff to evaluation queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;align=left;spacing=10;fontSize=11;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="230" height="150" as="geometry"/>
        </mxCell>

        <!-- Edge P1 -> P2 -->
        <mxCell id="e_p1_p2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Phase 3: Evaluation -->
        <mxCell id="p3" value="&lt;b&gt;PHASE 3: Eligibility Review&lt;/b&gt;&lt;br&gt;&lt;i&gt;status: under_evaluation&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Income, residency, voter audit&lt;br&gt;• Multi-criteria decision engine&lt;br&gt;• &lt;b&gt;Approve&lt;/b&gt; → Phase 4&lt;br&gt;• &lt;b&gt;Return&lt;/b&gt; → Missing docs loop&lt;br&gt;• &lt;b&gt;Reject&lt;/b&gt; → Archive with remarks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0891B2;align=left;spacing=10;fontSize=11;fontColor=#0E7490;" vertex="1" parent="1">
          <mxGeometry x="690" y="100" width="230" height="150" as="geometry"/>
        </mxCell>

        <!-- Edge P2 -> P3 -->
        <mxCell id="e_p2_p3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="p2" target="p3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Return Loop P3 -> P2 -->
        <mxCell id="loop_p3_p2" value="Needs Documents" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;strokeColor=#EA580C;strokeWidth=2;dashed=1;fontColor=#EA580C;fontSize=10;" edge="1" parent="1" source="p3" target="p2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="805" y="70"/>
              <mxPoint x="475" y="70"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Phase 4: Form Generation -->
        <mxCell id="p4" value="&lt;b&gt;PHASE 4: Form Gen &amp;amp; Signing&lt;/b&gt;&lt;br&gt;&lt;i&gt;ready_for_form → form_ready&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Priority-ordered form queue&lt;br&gt;• PyMuPDF generates official PDF&lt;br&gt;• Physical department signatures&lt;br&gt;• Signed form scanned back in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;align=left;spacing=10;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="690" y="320" width="230" height="150" as="geometry"/>
        </mxCell>

        <!-- Edge P3 -> P4 -->
        <mxCell id="e_p3_p4" value="Approved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#059669;strokeWidth=2;fontColor=#059669;fontSize=10;fontStyle=1;" edge="1" parent="1" source="p3" target="p4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Phase 5: Lot Awarding -->
        <mxCell id="p5" value="&lt;b&gt;PHASE 5: Lot Award &amp;amp; SMS&lt;/b&gt;&lt;br&gt;&lt;i&gt;ready_for_lot_award → awarded&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Schedule orientation date &amp;amp; venue&lt;br&gt;• Automated Twilio SMS alert&lt;br&gt;• Public draw lots ceremony&lt;br&gt;• Creates binding LotAward record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;align=left;spacing=10;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="360" y="320" width="230" height="150" as="geometry"/>
        </mxCell>

        <!-- Edge P4 -> P5 -->
        <mxCell id="e_p4_p5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="p4" target="p5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Phase 6: Post-Occupancy -->
        <mxCell id="p6" value="&lt;b&gt;PHASE 6: Occupancy Monitoring&lt;/b&gt;&lt;br&gt;&lt;i&gt;occupied → monitored / closed&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Unit marked Occupied&lt;br&gt;• 30-day inspection milestones&lt;br&gt;• Field inspector photo audits&lt;br&gt;• Dispute handling &amp;amp; case logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;align=left;spacing=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="220" height="150" as="geometry"/>
        </mxCell>

        <!-- Edge P5 -> P6 -->
        <mxCell id="e_p5_p6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="p5" target="p6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
