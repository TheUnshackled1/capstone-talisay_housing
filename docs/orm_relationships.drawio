        <!-- LotAward -->
        <mxCell id="m_lotaward" value="&lt;b&gt;LotAward&lt;/b&gt;&lt;br&gt;• id (uuid, PK)&lt;br&gt;• application_id (FK)&lt;br&gt;• housing_unit_id (FK)&lt;br&gt;• status (awarded, etc.)&lt;br&gt;• via_draw_lots (bool)&lt;br&gt;• awarded_by (FK User)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;align=left;spacing=8;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="790" y="100" width="180" height="140" as="geometry"/>
        </mxCell>

        <!-- Edge Application -> LotAward (PROTECT) -->
        <mxCell id="edge_applic_award" value="PROTECT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#DC2626;strokeWidth=2;fontColor=#DC2626;fontSize=9;fontStyle=1;" edge="1" parent="1" source="m_application" target="m_lotaward">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- HousingUnit -->
        <mxCell id="m_unit" value="&lt;b&gt;HousingUnit&lt;/b&gt;&lt;br&gt;• id (uuid, PK)&lt;br&gt;• site_id (FK RelocationSite)&lt;br&gt;• block_number (varchar)&lt;br&gt;• lot_number (varchar)&lt;br&gt;• status (vacant, occupied)&lt;br&gt;• plan_polygon_index (int)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;align=left;spacing=8;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="790" y="290" width="180" height="140" as="geometry"/>
        </mxCell>

        <!-- Edge HousingUnit -> LotAward (PROTECT) -->
        <mxCell id="edge_unit_award" value="PROTECT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#DC2626;strokeWidth=2;fontColor=#DC2626;fontSize=9;fontStyle=1;" edge="1" parent="1" source="m_unit" target="m_lotaward">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Case -->
        <mxCell id="m_case" value="&lt;b&gt;Case (Dispute / Violation)&lt;/b&gt;&lt;br&gt;• id (uuid, PK)&lt;br&gt;• case_number (UK)&lt;br&gt;• case_type (varchar)&lt;br&gt;• status (opened, resolved)&lt;br&gt;• applicant_id (FK, Null)&lt;br&gt;• housing_unit_id (FK, Null)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;align=left;spacing=8;fontSize=11;fontColor=#7F1D1D;" vertex="1" parent="1">
          <mxGeometry x="540" y="320" width="180" height="140" as="geometry"/>
        </mxCell>

        <!-- Edge Applicant -> Case (SET_NULL) -->
        <mxCell id="edge_app_case" value="SET_NULL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#D97706;strokeWidth=2;fontColor=#D97706;fontSize=9;fontStyle=1;" edge="1" parent="1" source="m_applicant" target="m_case">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edge Unit -> Case (SET_NULL) -->
        <mxCell id="edge_unit_case" value="SET_NULL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#D97706;strokeWidth=2;fontColor=#D97706;fontSize=9;fontStyle=1;" edge="1" parent="1" source="m_unit" target="m_case">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
