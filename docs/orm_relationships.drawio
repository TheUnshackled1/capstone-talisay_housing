<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="IHSMS-Architecture-ORM" version="22.1.0" type="device">
  <diagram id="orm_relationships" name="Core ORM Relationships &amp; Cascade Rules">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Header -->
        <mxCell id="orm_title" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;Core ORM Relationships &amp;amp; Cascade Integrity Rules&lt;/b&gt;&lt;br&gt;Entity dependencies, cardinalities, and institutional data retention constraints" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="800" height="50" as="geometry"/>
        </mxCell>

        <!-- Barangay -->
        <mxCell id="m_barangay" value="&lt;b&gt;Barangay&lt;/b&gt;&lt;br&gt;• id (bigint, PK)&lt;br&gt;• name (varchar, UK)&lt;br&gt;• is_active (bool)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;align=left;spacing=8;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="160" height="100" as="geometry"/>
        </mxCell>

        <!-- Applicant (Hub) -->
        <mxCell id="m_applicant" value="&lt;b&gt;Applicant (Core Hub)&lt;/b&gt;&lt;br&gt;• id (uuid, PK)&lt;br&gt;• reference_number (UK)&lt;br&gt;• full_name (varchar)&lt;br&gt;• barangay_id (FK)&lt;br&gt;• monthly_income (decimal)&lt;br&gt;• years_residing (int)&lt;br&gt;• status (choice)&lt;br&gt;• created_by_id (FK User)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;align=left;spacing=8;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="270" y="100" width="200" height="170" as="geometry"/>
        </mxCell>

        <!-- Edge Barangay -> Applicant (PROTECT) -->
        <mxCell id="edge_brgy_app" value="PROTECT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#DC2626;strokeWidth=2;fontColor=#DC2626;fontSize=9;fontStyle=1;" edge="1" parent="1" source="m_barangay" target="m_applicant">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- HouseholdMember -->
        <mxCell id="m_household" value="&lt;b&gt;HouseholdMember&lt;/b&gt;&lt;br&gt;• id (uuid, PK)&lt;br&gt;• applicant_id (FK)&lt;br&gt;• full_name (varchar)&lt;br&gt;• relationship (varchar)&lt;br&gt;• age (int)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;align=left;spacing=8;fontSize=11;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="160" height="110" as="geometry"/>
        </mxCell>

        <!-- Edge Applicant -> Household (CASCADE) -->
        <mxCell id="edge_app_hh" value="CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2563EB;strokeWidth=2;fontColor=#2563EB;fontSize=9;fontStyle=1;" edge="1" parent="1" source="m_applicant" target="m_household">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Document -->
        <mxCell id="m_doc" value="&lt;b&gt;Document (Vault)&lt;/b&gt;&lt;br&gt;• id (uuid, PK)&lt;br&gt;• applicant_id (FK)&lt;br&gt;• document_type (varchar)&lt;br&gt;• file_name (varchar)&lt;br&gt;• blob_id (FK Blob)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0891B2;align=left;spacing=8;fontSize=11;fontColor=#0E7490;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="160" height="110" as="geometry"/>
        </mxCell>

        <!-- Edge Applicant -> Document (CASCADE) -->
        <mxCell id="edge_app_doc" value="CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2563EB;strokeWidth=2;fontColor=#2563EB;fontSize=9;fontStyle=1;" edge="1" parent="1" source="m_applicant" target="m_doc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Application -->
        <mxCell id="m_application" value="&lt;b&gt;Application&lt;/b&gt;&lt;br&gt;• id (uuid, PK)&lt;br&gt;• application_number (UK)&lt;br&gt;• applicant_id (1:1)&lt;br&gt;• status (approved, etc.)&lt;br&gt;• standby_position (int)&lt;br&gt;• form_generated_at (dt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;align=left;spacing=8;fontSize=11;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="540" y="100" width="180" height="140" as="geometry"/>
        </mxCell>

        <!-- Edge Applicant -> Application (CASCADE) -->
        <mxCell id="edge_app_applic" value="CASCADE (1:1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2563EB;strokeWidth=2;fontColor=#2563EB;fontSize=9;fontStyle=1;" edge="1" parent="1" source="m_applicant" target="m_application">
          <mxGeometry relative="1" as="geometry"/>
