<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="IHSMS-Deployment-Pipeline" version="22.1.0" type="device">
  <diagram id="deployment_pipeline" name="Deployment Pipeline Stages">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Header Title -->
        <mxCell id="pipe_title" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;Deployment Pipeline &amp;amp; Lifecycle Stages&lt;/b&gt;&lt;br&gt;Integrated Housing Services and Monitoring System (IHSMS) · Talisay City Housing Authority (THA)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="800" height="50" as="geometry"/>
        </mxCell>

        <!-- Stage 1: Pull & Ingest -->
        <mxCell id="st1" value="&lt;b&gt;STAGE 1: Code Ingestion&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Clone/pull from GitHub `main`&lt;br&gt;• Verify clean working tree&lt;br&gt;• Load `.env` production secrets&lt;br&gt;• Inspect requirements diff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;align=left;spacing=10;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="175" height="230" as="geometry"/>
        </mxCell>

        <!-- Stage 2: Dependencies -->
        <mxCell id="st2" value="&lt;b&gt;STAGE 2: Dependencies&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Activate virtualenv (`venv`/`env`)&lt;br&gt;• `pip install -r requirements.txt`&lt;br&gt;• PyMuPDF, Django 6.0, allauth&lt;br&gt;• Compile Tailwind CSS 4 bundle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;align=left;spacing=10;fontSize=11;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="225" y="100" width="175" height="230" as="geometry"/>
        </mxCell>

        <!-- Connector 1 -> 2 -->
        <mxCell id="pe1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="st1" target="st2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Stage 3: Database & Auth -->
        <mxCell id="st3" value="&lt;b&gt;STAGE 3: Database &amp;amp; Sync&lt;/b&gt;&lt;br&gt;&lt;br&gt;• `python manage.py migrate`&lt;br&gt;• `createcachetable` for sessions&lt;br&gt;• `setup_google_oauth` site sync&lt;br&gt;• Seed reference data if needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#06B6D4;align=left;spacing=10;fontSize=11;fontColor=#0E7490;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="175" height="230" as="geometry"/>
        </mxCell>

        <!-- Connector 2 -> 3 -->
        <mxCell id="pe2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="st2" target="st3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Stage 4: Static Collection -->
        <mxCell id="st4" value="&lt;b&gt;STAGE 4: Static Assets&lt;/b&gt;&lt;br&gt;&lt;br&gt;• `manage.py collectstatic`&lt;br&gt;• Gather admin, dynamic forms, CSS&lt;br&gt;• WhiteNoise / web tab mappings&lt;br&gt;• Gzip/Brotli cache headers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;align=left;spacing=10;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="615" y="100" width="175" height="230" as="geometry"/>
        </mxCell>

        <!-- Connector 3 -> 4 -->
        <mxCell id="pe3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="st3" target="st4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Stage 5: Reload & Launch -->
        <mxCell id="st5" value="&lt;b&gt;STAGE 5: Reload &amp;amp; Health&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Reload WSGI / Gunicorn pool&lt;br&gt;• Verify HTTPS termination&lt;br&gt;• Execute `manage.py check`&lt;br&gt;• Test login, forms &amp;amp; SMS notice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;align=left;spacing=10;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="810" y="100" width="175" height="230" as="geometry"/>
        </mxCell>

        <!-- Connector 4 -> 5 -->
        <mxCell id="pe4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="st4" target="st5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
