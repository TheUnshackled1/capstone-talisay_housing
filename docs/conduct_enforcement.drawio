<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="IHSMS-Conduct-Workflow" version="22.1.0" type="device">
  <diagram id="conduct_enforcement" name="Code of Conduct Enforcement Workflow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- Header -->
        <mxCell id="hdr_title" value="Code of Conduct Enforcement Workflow&#xa;Integrated Housing Services and Monitoring System (IHSMS) · Talisay City Housing Authority (THA)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="800" height="50" as="geometry"/>
        </mxCell>

        <!-- Step 1: Incident Report -->
        <mxCell id="step1_card" value="&lt;b&gt;STEP 1: Incident Report&lt;/b&gt;&lt;br&gt;&lt;br&gt;Report submitted privately to maintainers via:&lt;br&gt;&lt;b&gt;jtcoronel.chmsu@gmail.com&lt;/b&gt;&lt;br&gt;or directly to THA management.&lt;br&gt;&lt;br&gt;&lt;i&gt;Reporter privacy protected&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;align=left;spacing=12;fontSize=12;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="240" height="150" as="geometry"/>
        </mxCell>

        <!-- Step 2: Investigation -->
        <mxCell id="step2_card" value="&lt;b&gt;STEP 2: Review &amp;amp; Assessment&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Maintainers review facts &amp;amp; context&lt;br&gt;• Assess impact and severity&lt;br&gt;• Maintain confidentiality&lt;br&gt;• Determine appropriate tier action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;align=left;spacing=12;fontSize=12;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="250" height="150" as="geometry"/>
        </mxCell>

        <!-- Connector Step 1 -> Step 2 -->
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="step1_card" target="step2_card">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Final Step: Resolution -->
        <mxCell id="step_final_card" value="&lt;b&gt;FINAL: Resolution &amp;amp; Logging&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Communicate outcome to parties&lt;br&gt;• Log action in confidential records&lt;br&gt;• Safeguard community health&lt;br&gt;• Prevent recurrence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;align=left;spacing=12;fontSize=12;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="720" y="100" width="240" height="150" as="geometry"/>
        </mxCell>

        <!-- Connector Step 2 -> Step Final -->
        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="step2_card" target="step_final_card">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Container for Tier Matrix -->
        <mxCell id="matrix_container" value="STEP 3: Enforcement Action Matrix" style="swimlane;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=1;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="300" width="910" height="230" as="geometry"/>
        </mxCell>

        <!-- Tier 1: Correction -->
        <mxCell id="t1" value="&lt;b&gt;1. Correction&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Private Written Warning&lt;/i&gt;&lt;br&gt;&lt;br&gt;Private clarity regarding nature of violation and educational guidance on expected standard." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;align=left;spacing=10;fontSize=11;fontColor=#334155;" vertex="1" parent="matrix_container">
          <mxGeometry y="30" width="225" height="200" as="geometry"/>
        </mxCell>

        <!-- Tier 2: Warning -->
        <mxCell id="t2" value="&lt;b&gt;2. Warning&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Formal Reprimand&lt;/i&gt;&lt;br&gt;&lt;br&gt;Formal warning with documented consequences if behavior persists within community spaces." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;align=left;spacing=10;fontSize=11;fontColor=#78350F;" vertex="1" parent="matrix_container">
          <mxGeometry x="225" y="30" width="225" height="200" as="geometry"/>
        </mxCell>

        <!-- Tier 3: Temporary Ban -->
        <mxCell id="t3" value="&lt;b&gt;3. Temporary Ban&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Interaction Suspension&lt;/i&gt;&lt;br&gt;&lt;br&gt;Suspension from interaction, issues, pull requests, or communications for a specified term." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;align=left;spacing=10;fontSize=11;fontColor=#7C2D12;" vertex="1" parent="matrix_container">
          <mxGeometry x="450" y="30" width="225" height="200" as="geometry"/>
        </mxCell>

        <!-- Tier 4: Permanent Ban -->
        <mxCell id="t4" value="&lt;b&gt;4. Permanent Ban&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Permanent Expulsion&lt;/i&gt;&lt;br&gt;&lt;br&gt;Indefinite ban from public interaction, code review, issues, and contributions for severe violations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;align=left;spacing=10;fontSize=11;fontColor=#7F1D1D;" vertex="1" parent="matrix_container">
          <mxGeometry x="675" y="30" width="235" height="200" as="geometry"/>
        </mxCell>

        <!-- Connector Step 2 -> Matrix -->
        <mxCell id="edge_to_matrix" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="step2_card" target="matrix_container">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
