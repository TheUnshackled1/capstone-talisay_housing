        <!-- Tier 3: Technical & GitHub Issue Tracker -->
        <mxCell id="t3" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;💻 TIER 3: Technical Support&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color: #5b21b6; font-size: 10px;&quot;&gt;ENGINEERING &amp;amp; GITHUB&lt;/i&gt;&lt;br&gt;&lt;br&gt;• GitHub Issue Tracker (Bugs/Ideas)&lt;br&gt;• PyMuPDF coordinate calibration&lt;br&gt;• Database migration adjustments&lt;br&gt;• Semaphore SMS gateway issues&lt;br&gt;• Google OAuth credential updates&lt;br&gt;• CHMSU Capstone Dev Leads&lt;br&gt;• jtcoronel.chmsu@gmail.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;align=left;spacing=8;fontSize=11;fontColor=#4C1D95;" vertex="1" parent="1">
