        <!-- Tier 4: Security Policy (Private) -->
        <mxCell id="t4" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🛡️ TIER 4: Security Policy&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color: #991b1b; font-size: 10px;&quot;&gt;CONFIDENTIAL REPORTING&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Auth bypass &amp;amp; privilege leaks&lt;br&gt;• Citizen data confidentiality&lt;br&gt;• CSRF / SQLi vulnerability&lt;br&gt;• DO NOT open public GitHub issues&lt;br&gt;• Strictly follow SECURITY.md&lt;br&gt;• Acknowledged within 24 hours&lt;br&gt;• Direct: jtcoronel.chmsu@gmail.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;align=left;spacing=8;fontSize=11;fontColor=#991B1B;" vertex="1" parent="1">
