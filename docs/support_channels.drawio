<mxfile host="app.diagrams.net" agent="IHSMS-Support" version="22.1.0" type="device">
  <diagram id="support_channels" name="IHSMS Support &amp; Escalation Channels">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
