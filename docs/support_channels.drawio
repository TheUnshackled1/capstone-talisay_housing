        <!-- Header -->
        <mxCell id="sc_title" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;Integrated Housing Services and Monitoring System (IHSMS)&lt;/b&gt;&lt;br&gt;Support Escalation Flow &amp;amp; Institutional Channels — Talisay City Housing Authority (THA)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="75" y="20" width="900" height="50" as="geometry"/>
        </mxCell>

        <!-- Tier 1: Self-Service Documentation -->
        <mxCell id="t1" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;📖 TIER 1: Self-Service Docs&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color: #1e40af; font-size: 10px;&quot;&gt;FIRST LINE OF INQUIRY&lt;/i&gt;&lt;br&gt;&lt;br&gt;• INSTRUCTIONS.md (Dev Setup)&lt;br&gt;• README.md (Architecture &amp;amp; APIs)&lt;br&gt;• notes/user_guide.md (Staff Manual)&lt;br&gt;• notes/dashboard_analytics_explainer.md&lt;br&gt;• DEPLOYMENT.md (Railway/Linux)&lt;br&gt;• ARCHITECTURE.md (Deep Dive)&lt;br&gt;• Environment variables reference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;align=left;spacing=8;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="220" height="380" as="geometry"/>
        </mxCell>

        <!-- Connector 1 -> 2 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2563EB;strokeWidth=2;" edge="1" parent="1" source="t1" target="t2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Tier 2: THA Operational Support -->
        <mxCell id="t2" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🏢 TIER 2: THA Operations&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color: #065f46; font-size: 10px;&quot;&gt;CITY HALL FRONT DESK&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Citizen walk-in intake queries&lt;br&gt;• Public applicant status lookups&lt;br&gt;• Physical document verification&lt;br&gt;• Draw-lots orientation schedules&lt;br&gt;• Caretaker field inspection issues&lt;br&gt;• Community dispute desk intake&lt;br&gt;• Talisay City Hall, Negros Occ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;align=left;spacing=8;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
