<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="IHSMS-PR-Lifecycle" version="22.1.0" type="device">
  <diagram id="pr_lifecycle" name="Pull Request Review Lifecycle">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Header -->
        <mxCell id="pr_title" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;Pull Request Review Lifecycle&lt;/b&gt;&lt;br&gt;Integrated Housing Services and Monitoring System (IHSMS) · Talisay City Housing Authority (THA)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="800" height="50" as="geometry"/>
        </mxCell>

        <!-- Stage 1: PR Opened -->
        <mxCell id="st1" value="&lt;b&gt;STAGE 1: PR Opened&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Author opens PR against `main`&lt;br&gt;• Clear title &amp;amp; description&lt;br&gt;• Linked issue reference (e.g. Closes #12)&lt;br&gt;• Screenshots/proofs attached for UI changes&lt;br&gt;• Clean commit history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;align=left;spacing=10;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="200" height="230" as="geometry"/>
        </mxCell>

        <!-- Stage 2: Automated Checks -->
        <mxCell id="st2" value="&lt;b&gt;STAGE 2: Automated Checks&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Django integrity check (`manage.py check`)&lt;br&gt;• Automated unit tests (`manage.py test`)&lt;br&gt;• Tailwind build verification&lt;br&gt;• Migration compatibility check&lt;br&gt;• No conflicting migrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;align=left;spacing=10;fontSize=11;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="290" y="100" width="200" height="230" as="geometry"/>
        </mxCell>

        <!-- Connector 1 -> 2 -->
        <mxCell id="pr_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="st1" target="st2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Stage 3: Maintainer Review -->
        <mxCell id="st3" value="&lt;b&gt;STAGE 3: Maintainer Review&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Review by THA engineering team&lt;br&gt;• Code style (PEP 8) &amp;amp; architecture evaluation&lt;br&gt;• Security &amp;amp; role access validation&lt;br&gt;• Functional test of housing business logic&lt;br&gt;• Decision: Approve or Request Changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;align=left;spacing=10;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="530" y="100" width="210" height="230" as="geometry"/>
        </mxCell>

        <!-- Connector 2 -> 3 -->
        <mxCell id="pr_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="st2" target="st3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Stage 4: Merge & Deploy -->
        <mxCell id="st4" value="&lt;b&gt;STAGE 4: Merge &amp;amp; Deploy&lt;/b&gt;&lt;br&gt;&lt;br&gt;• PR approved and squashed into `main`&lt;br&gt;• Automated Railway container deployment&lt;br&gt;• Closes resolved issues&lt;br&gt;• Contributor credited in project notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;align=left;spacing=10;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="780" y="100" width="200" height="230" as="geometry"/>
        </mxCell>

        <!-- Connector 3 -> 4 -->
        <mxCell id="pr_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="st3" target="st4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Feedback Loop Connector 3 -> 1 -->
        <mxCell id="pr_loop" value="Revisions Requested" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=#F59E0B;strokeWidth=2;dashed=1;fontColor=#92400E;fontSize=10;" edge="1" parent="1" source="st3" target="st1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="635" y="370"/>
              <mxPoint x="150" y="370"/>
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
