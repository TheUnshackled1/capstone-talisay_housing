<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="IHSMS-Changelog-Timeline" version="22.1.0" type="device">
  <diagram id="changelog_timeline" name="System Version History &amp; Release Timeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Header -->
        <mxCell id="tl_title" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;System Version History &amp;amp; Milestone Timeline&lt;/b&gt;&lt;br&gt;Architectural phases culminating in the IHSMS Version 1.0.0 Production Release" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="800" height="50" as="geometry"/>
        </mxCell>

        <!-- Milestone 1 -->
        <mxCell id="ms1" value="&lt;b&gt;STAGE 1: Architecture &amp;amp; Auth&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Django 6.0 + PostgreSQL&lt;br&gt;• Tailwind CSS 4 CLI build&lt;br&gt;• Custom User &amp;amp; Barangay models&lt;br&gt;• Staff portal role middleware&lt;br&gt;• Google OAuth (django-allauth)&lt;br&gt;• WhiteNoise asset pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;align=left;spacing=8;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="170" height="230" as="geometry"/>
        </mxCell>

        <!-- Milestone 2 -->
        <mxCell id="ms2" value="&lt;b&gt;STAGE 2: Intake &amp;amp; Vault&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Walk-in citizen intake forms&lt;br&gt;• Biometrics &amp;amp; family rosters&lt;br&gt;• Tracking code engine (`APP-` ID)&lt;br&gt;• CDRRMO displacement tags&lt;br&gt;• Dynamic Web TWAIN scanner&lt;br&gt;• 7-point document checklist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;align=left;spacing=8;fontSize=11;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="235" y="100" width="170" height="230" as="geometry"/>
        </mxCell>

        <!-- Connector 1 -> 2 -->
        <mxCell id="tl_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="ms1" target="ms2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Milestone 3 -->
        <mxCell id="ms3" value="&lt;b&gt;STAGE 3: Evaluation &amp;amp; PDF&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Standardized criteria scoring&lt;br&gt;• Three-way decision triage&lt;br&gt;• Pre-check summary review&lt;br&gt;• PyMuPDF form injection&lt;br&gt;• Official 2-page THA PDF form&lt;br&gt;• Physical sign-off &amp;amp; re-scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0891B2;align=left;spacing=8;fontSize=11;fontColor=#0E7490;" vertex="1" parent="1">
          <mxGeometry x="430" y="100" width="170" height="230" as="geometry"/>
        </mxCell>

        <!-- Connector 2 -> 3 -->
        <mxCell id="tl_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="ms2" target="ms3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Milestone 4 -->
        <mxCell id="ms4" value="&lt;b&gt;STAGE 4: Lot Award &amp;amp; SMS&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Lot award ceremony queue&lt;br&gt;• Public draw lots allocation&lt;br&gt;• Orientation scheduling&lt;br&gt;• Automated Twilio SMS alerts&lt;br&gt;• Binding `LotAward` contracts&lt;br&gt;• Relocation site management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;align=left;spacing=8;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="625" y="100" width="170" height="230" as="geometry"/>
        </mxCell>

        <!-- Connector 3 -> 4 -->
        <mxCell id="tl_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="ms3" target="ms4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Milestone 5 -->
        <mxCell id="ms5" value="&lt;b&gt;STAGE 5: v1.0.0 Production GA&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Unit occupancy lifecycle&lt;br&gt;• SVG lot polygon map plan&lt;br&gt;• 30-day inspection milestones&lt;br&gt;• Community dispute case logs&lt;br&gt;• Interactive analytics dashboard&lt;br&gt;• Railway Cloud Deployment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;align=left;spacing=8;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="170" height="230" as="geometry"/>
        </mxCell>

        <!-- Connector 4 -> 5 -->
        <mxCell id="tl_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="ms4" target="ms5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
