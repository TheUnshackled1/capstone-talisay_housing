<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="IHSMS-Roadmap" version="22.1.0" type="device">
  <diagram id="roadmap_milestones" name="IHSMS System Feature Roadmap &amp; Release Milestones">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Header -->
        <mxCell id="rm_title" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;Integrated Housing Services and Monitoring System (IHSMS)&lt;/b&gt;&lt;br&gt;Strategic Product Vision &amp;amp; Multi-Phase Release Roadmap — Talisay City Housing Authority (THA)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="75" y="20" width="900" height="50" as="geometry"/>
        </mxCell>

        <!-- Milestone 1: v1.0.0 (Released) -->
        <mxCell id="m1" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;✅ v1.0.0 — Production GA&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color: #065f46; font-size: 10px;&quot;&gt;RELEASED &amp;amp; CURRENT (2026)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Walk-in intake &amp;amp; eligibility engine&lt;br&gt;• CDRRMO hazard pre-screening&lt;br&gt;• Digital Document Vault &amp;amp; scanner&lt;br&gt;• Google Drive OAuth integration&lt;br&gt;• PyMuPDF THA 2-page form PDF&lt;br&gt;• Public raffle &amp;amp; lot awarding queue&lt;br&gt;• Interactive SVG lot polygon map&lt;br&gt;• 30/60/90-day unit monitoring&lt;br&gt;• Community dispute desk &amp;amp; field logs&lt;br&gt;• Automated Semaphore SMS alerts&lt;br&gt;• Public `/status/&amp;lt;ref&amp;gt;/` tracker&lt;br&gt;• Railway PostgreSQL cloud deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;align=left;spacing=8;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="220" height="380" as="geometry"/>
        </mxCell>

        <!-- Connector 1 -> 2 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="m1" target="m2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Milestone 2: v1.1.0 (Q3 2026) -->
        <mxCell id="m2" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🎯 v1.1.0 — Field PWA &amp;amp; QR&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color: #1e40af; font-size: 10px;&quot;&gt;SHORT-TERM (Q3 2026)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Unit QR code badging &amp;amp; stickers&lt;br&gt;• Mobile camera QR code scanner&lt;br&gt;• Drone aerial orthophoto map layer&lt;br&gt;• Visual lot boundary encroachment&lt;br&gt;• Celery/cron automated SMS reminders&lt;br&gt;• Inspection date SMS broadcasts&lt;br&gt;• ReportLab COA audit PDF reports&lt;br&gt;• Official THA signature stamp blocks&lt;br&gt;• One-click `.xlsx` &amp;amp; `.csv` exports&lt;br&gt;• Household size audit validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;align=left;spacing=8;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="290" y="95" width="220" height="380" as="geometry"/>
        </mxCell>

        <!-- Connector 2 -> 3 -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="m2" target="m3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Milestone 3: v1.2.0 (Q4 2026) -->
        <mxCell id="m3" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🔮 v1.2.0 — Citizen &amp;amp; Billing&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color: #6b21a8; font-size: 10px;&quot;&gt;MEDIUM-TERM (Q4 2026)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Public citizen online pre-intake&lt;br&gt;• Mobile requirement photo upload&lt;br&gt;• Monthly lot amortization ledger&lt;br&gt;• Official receipt &amp;amp; payment tracking&lt;br&gt;• Delinquency alert escalation&lt;br&gt;• CDRRMO real-time hazard API sync&lt;br&gt;• City Assessor tax roll API sync&lt;br&gt;• Digital PKI signatures on Awards&lt;br&gt;• Granular sub-department RBAC&lt;br&gt;• Multi-language Ilonggo/English UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;align=left;spacing=8;fontSize=11;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="540" y="95" width="220" height="380" as="geometry"/>
        </mxCell>

        <!-- Connector 3 -> 4 -->
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#94A3B8;strokeWidth=2;" edge="1" parent="1" source="m3" target="m4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Milestone 4: v2.0.0 (2027) -->
        <mxCell id="m4" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🚀 v2.0.0 — Native App &amp;amp; AI&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color: #92400e; font-size: 10px;&quot;&gt;LONG-TERM VISION (2027)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Native Flutter/React Native app&lt;br&gt;• Offline-first SQLite local sync&lt;br&gt;• GPS geotagged photo capture&lt;br&gt;• Django Channels WebSockets alerts&lt;br&gt;• Instant field-to-desk case alerts&lt;br&gt;• Inter-LGU housing registry sync&lt;br&gt;• Cross-city double-dipping checks&lt;br&gt;• AI predictive housing demand&lt;br&gt;• Automated vulnerability scoring&lt;br&gt;• Open REST API for LGU integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;align=left;spacing=8;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="790" y="95" width="220" height="380" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
