# Copy this to .env and fill in your actual values
SMS_ENABLED=True

# Use "console" for local testing (prints SMS content in runserver terminal).
# Use "semaphore" for live sending once SEMAPHORE_API_KEY is set.
SMS_SERVICE=console

# Semaphore API key — https://semaphore.co/docs (required when SMS_SERVICE=semaphore)
SEMAPHORE_API_KEY=

# Optional Semaphore sender name (max 11 alphanumeric chars); omit to use account default.
SEMAPHORE_SENDER_NAME=

# Optional tuning for slower networks
SEMAPHORE_SEND_TIMEOUT_SECONDS=25
SEMAPHORE_SEND_RETRY_ATTEMPTS=3
SEMAPHORE_SEND_RETRY_BACKOFF_SECONDS=1.5
