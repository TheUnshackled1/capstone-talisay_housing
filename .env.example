# Copy to .env (gitignored) and fill in your values. Never commit .env or API keys to git.
SMS_ENABLED=True

# console = runserver terminal only (no credits). semaphore = live SMS via Semaphore.
SMS_SERVICE=semaphore

# From Semaphore dashboard → Account Settings → API Key
SEMAPHORE_API_KEY=your_semaphore_api_key_here

# Registered Semaphore sender name (max 11 chars), e.g. THAOFFICE
SEMAPHORE_SENDER_NAME=THAOFFICE

# Optional tuning for slower networks
SEMAPHORE_SEND_TIMEOUT_SECONDS=25
SEMAPHORE_SEND_RETRY_ATTEMPTS=3
SEMAPHORE_SEND_RETRY_BACKOFF_SECONDS=1.5
